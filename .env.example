# =====================================================================
# CarDigno - Environment Configuration Template
# Copy this file to '.env' and modify values as required for your environment.
# NEVER commit your actual '.env' file containing real secrets to GitHub.
# =====================================================================

# Environment mode ('development', 'testing', 'production')
CARDIGNO_ENV=development

# Telemetry Simulator Settings
# Default to loopback 127.0.0.1 for local isolation.
CARDIGNO_SIM_HOST=127.0.0.1
CARDIGNO_SIM_PORT=8000
CARDIGNO_SIM_RATE_HZ=10.0

# Telemetry Ingestion & Storage Settings
CARDIGNO_DB_PATH=database/telemetry.db
CARDIGNO_BATCH_SIZE=10

# Application API & WebSocket Service (Phases 4-5)
CARDIGNO_API_HOST=127.0.0.1
CARDIGNO_API_PORT=8080
CARDIGNO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Security & Authentication
# Generate a strong key for production (e.g. `openssl rand -hex 32`)
CARDIGNO_SECRET_KEY=change-this-in-production-to-a-secure-random-token

# Logging
# Supported: DEBUG, INFO, WARNING, ERROR, CRITICAL
CARDIGNO_LOG_LEVEL=INFO
